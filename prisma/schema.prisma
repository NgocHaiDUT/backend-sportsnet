// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model account {
  Id         Int       @id @default(autoincrement())
  Fullname   String
  User_name  String    @unique
  Password   String
  Role       String    
  Email      String
  Story      String
  Avatar     String?
  phone      String?   // New field for phone number
  QR_Payment String?
  // VietQR dynamic generation fields
  vietqr_bank_code      String?
  vietqr_account_number String?
  vietqr_account_name   String?
  vietqr_addinfo_prefix String?
  vietqr_template       String?  @default("print")
  vietqr_is_enabled     Boolean? @default(false)
  // MỚI: Một chủ sân (OWNER) sở hữu nhiều khu sân
  ownedSportFields SportField[]    @relation("OwnerRelation")

  // SỬA ĐỔI: Thêm relation tới Booking
  bookings         Booking[]       @relation("AccountBookings")

  // ... (các relation cũ không đổi)
  posts            post[]          @relation("AccountPosts")
  comments         comment[]       @relation("AccountComments")
  sentMessages     messages[]      @relation("SentMessages")
  receivedMessages messages[]      @relation("ReceivedMessages")
  notifications    notification[]  @relation("AccountNotifications")
  actorNotifications notification[] @relation("ActorNotifications")
  followers        follow[]        @relation("FollowingRelation")
  following        follow[]        @relation("FollowerRelation")
  likes            post_like[]     @relation("AccountLikes")
  commentLikes     comment_like[]  @relation("AccountCommentLikes")
  blockedUsers     block[]         @relation("BlockerRelation")
  blockedBy        block[]         @relation("BlockedRelation")
  sportFieldReviews SportFieldReview[] // Thêm relation tới reviews
}

model post {
  Id          Int       @id @default(autoincrement())
  User_id     Int
  Type        String
  Time        DateTime
  Title       String
  Video       String?
  Mode        String
  Content     String
  Heart_count Int
  Address     String?
  Sports      String?
  Topic       String?

  account account @relation("AccountPosts", fields: [User_id], references: [Id])
  comments comment[]
  likes    post_like[]  @relation("PostLikes")
  images   image[]      @relation("PostImages")
}

model image {
  Id      Int    @id @default(autoincrement())
  Post_id Int
  Url     String
  Order   Int    @default(0)

  post post @relation("PostImages", fields: [Post_id], references: [Id], onDelete: Cascade)
}

model comment {
  Id         Int      @id @default(autoincrement())
  Id_account Int
  Post_id    Int
  CreateAt   DateTime
  Parent_id  Int?
  Like_count Int
  Content    String

  account account @relation("AccountComments", fields: [Id_account], references: [Id])
  post    post    @relation(fields: [Post_id], references: [Id])
  likes   comment_like[] @relation("CommentLikes")
}

model messages {
  Id          Int      @id @default(autoincrement())
  Sender_id   Int
  Receiver_id Int
  Content     String
  Status      Boolean
  CreateAt    DateTime
  
  // ✅ Add shared post support
  shared_post_id   Int?
  shared_post_data String?

  sender   account @relation("SentMessages", fields: [Sender_id], references: [Id])
  receiver account @relation("ReceivedMessages", fields: [Receiver_id], references: [Id])
}



// SỬA ĐỔI: Model `notification` để liên kết với Booking
model notification {
  Id       Int      @id @default(autoincrement())
  User_id  Int      // Người nhận thông báo (owner)
  Actor_id Int?     // Người gây ra hành động (user đặt sân)
  Title    String   // Nội dung thông báo
  Is_read  Boolean  @default(false)
  CreateAt DateTime @default(now())

  // MỚI: Liên kết thông báo với một đơn hàng cụ thể
  bookingId Int?    @unique
  
  account account  @relation("AccountNotifications", fields: [User_id], references: [Id])
  actor   account? @relation("ActorNotifications", fields: [Actor_id], references: [Id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}


model follow {
  Id           Int      @id @default(autoincrement())
  Follower_id  Int
  Following_id Int
  CreatedAt    DateTime

  follower  account @relation("FollowerRelation", fields: [Follower_id], references: [Id])
  following account @relation("FollowingRelation", fields: [Following_id], references: [Id])
}

model post_like {
  Id       Int      @id @default(autoincrement())
  User_id  Int
  Post_id  Int

  account account @relation("AccountLikes", fields: [User_id], references: [Id])
  post    post    @relation("PostLikes", fields: [Post_id], references: [Id])
}

model comment_like {
  Id         Int      @id @default(autoincrement())
  User_id    Int
  Comment_id Int

  account account @relation("AccountCommentLikes", fields: [User_id], references: [Id])
  comment comment @relation("CommentLikes", fields: [Comment_id], references: [Id])

  @@unique([User_id, Comment_id])
  
}

// Add new model for blocks
model block {
  Id         Int      @id @default(autoincrement())
  User_id    Int
  Blocked_id Int
  CreatedAt  DateTime @default(now())

  user    account @relation("BlockerRelation", fields: [User_id], references: [Id])
  blocked account @relation("BlockedRelation", fields: [Blocked_id], references: [Id])

  @@unique([User_id, Blocked_id])
}

model SportField {
  id        Int     @id @default(autoincrement())
  name      String
  address   String
  city      String
  sport     String
  district  String
  courts    Court[]
  reviews   SportFieldReview[] // Thêm relation tới reviews

  // MỚI: Liên kết tới chủ sở hữu
  ownerId   Int
  owner     account @relation("OwnerRelation", fields: [ownerId], references: [Id])
}

model Court {
  id           Int           @id @default(autoincrement())
  name         String
  sportFieldId Int
  weekdayPrice Float
  weekendPrice Float
  
  sportField   SportField    @relation(fields: [sportFieldId], references: [id])
  bookingSlots BookingSlot[]
}

model Booking {
  id           Int           @id @default(autoincrement())
  User_id      Int
  createdAt    DateTime      @default(now())
  totalPrice   Float
  status       String
  paymentProof String?
  note         String?       // New field for booking notes
  
  account      account       @relation("AccountBookings", fields: [User_id], references: [Id])
  bookingSlots BookingSlot[]
  
  // MỚI: Một booking sẽ có một thông báo
  notification notification?
}

model BookingSlot {
  id        Int      @id @default(autoincrement())
  bookingId Int
  courtId   Int
  startTime DateTime
  endTime   DateTime
  price     Float

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id])

  @@unique([courtId, startTime])
}

model SportFieldReview {
  id           Int       @id @default(autoincrement())
  userId       Int
  sportFieldId Int
  rating       Int       // 1 đến 5
  comment      String?
  createdAt    DateTime  @default(now())
  // Quan hệ
  user        account    @relation(fields: [userId], references: [Id])
  sportField  SportField @relation(fields: [sportFieldId], references: [id])

  @@unique([userId, sportFieldId]) // Mỗi user chỉ review 1 lần cho mỗi sân
}

